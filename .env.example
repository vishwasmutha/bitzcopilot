# --- Required -----------------------------------------------------------
# PostgreSQL connection string used by Drizzle ORM (src/db/index.ts)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bizcopilot_dev

# --- Sessions -----------------------------------------------------------
# HS256 secret for the httpOnly session cookie (JWT). Use a long random
# string in production:  `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# --- Optional: Generative AI providers ----------------------------------
# Configure ONE (or both). OPENAI takes priority if both are set.
# Without a key, BizCopilot automatically falls back to its built-in
# grounded reasoning engine — all figures still come from the database.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Daily operator -----------------------------------------------------
# Protects /api/cron/daily (Vercel Cron sends it automatically). Without it the endpoint stays closed.
#   openssl rand -hex 24
CRON_SECRET=
# Optional: send the morning brief to the owner's WhatsApp (Meta WhatsApp Cloud API).
# Without these the brief is still saved in the app and shown on the bell.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
